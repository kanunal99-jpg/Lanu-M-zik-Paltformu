# GEMINI_API_KEY: Required for Gemini AI API calls when enabled.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Jamendo developer client id for the verified streaming catalog.
# Create a Jamendo developer application and put the real client id here.
# Do not use a test-only id for production distribution.
JAMENDO_CLIENT_ID=YOUR_JAMENDO_CLIENT_ID
